# ==============================================================================
# Infynno MCAT Question Bank Generator - Environment Configuration Template
# Copy this file to '.env' and populate your API credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active LLM Provider Selection
# ------------------------------------------------------------------------------
# Easily switch between providers: 'deepinfra', 'anthropic', or 'openai'
ACTIVE_LLM_PROVIDER=deepinfra

# ------------------------------------------------------------------------------
# 2. Anthropic Configuration (Model, Official Pricing & Credentials)
# ------------------------------------------------------------------------------
# Default model: Claude Haiku 5.5 ($0.10 in / $0.50 out per 1M tokens)
# Alternative models: claude-3-5-sonnet-20241022 ($3.00 / $15.00), claude-3-5-haiku-20241022 ($0.80 / $4.00)
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_COST_PER_MILLION_INPUT_TOKENS=0.10
ANTHROPIC_COST_PER_MILLION_OUTPUT_TOKENS=0.50
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 3. DeepInfra Configuration (Model, Official Pricing & Credentials)
# ------------------------------------------------------------------------------
DEEPINFRA_MODEL=deepinfra/deepseek-ai/DeepSeek-V4.1-Flash-1017
DEEPINFRA_COST_PER_MILLION_INPUT_TOKENS=0.098
DEEPINFRA_COST_PER_MILLION_OUTPUT_TOKENS=0.294
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# ------------------------------------------------------------------------------
# 3b. OpenAI Configuration (Model, Official Pricing & Credentials)
# ------------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
OPENAI_COST_PER_MILLION_INPUT_TOKENS=0.15
OPENAI_COST_PER_MILLION_OUTPUT_TOKENS=0.60
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Active Image Provider Selection
# ------------------------------------------------------------------------------
# Easily switch between image engines: 'deepinfra' or 'openai'
ACTIVE_IMAGE_PROVIDER=deepinfra

# ------------------------------------------------------------------------------
# 4a. DeepInfra Image Configuration (Model, Official Pricing & Settings)
# ------------------------------------------------------------------------------
# Default model: black-forest-labs/FLUX-2-klein-4b ($0.014 per 1024x1024 base unit)
# Alternative models: black-forest-labs/FLUX-1-schnell ($0.0005/step)
DEEPINFRA_IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b
DEEPINFRA_IMAGE_COST_PER_UNIT=0.014

# ------------------------------------------------------------------------------
# 4b. OpenAI Image Configuration (Model, Official Pricing & Settings)
# ------------------------------------------------------------------------------
# Default model: gpt-image-2.5-flare ($0.020 per 1024x1024 base unit)
# Alternative models: gpt-image-2.5-sunburst ($0.060), dall-e-3 ($0.040 Standard / $0.080 HD)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_COST_PER_UNIT=0.020

# ------------------------------------------------------------------------------
# 4c. Visual Stimuli Dimensions & Shared Generation Parameters
# ------------------------------------------------------------------------------
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_ITERS=0
IMAGE_COST_PER_BASE_UNIT=0.014

# ------------------------------------------------------------------------------
# 5. Multi-Agent Workflow Parameters & Psychometric Quality Thresholds
# ------------------------------------------------------------------------------
MAX_REGENERATION_ATTEMPTS=3
PASSING_SCORE_THRESHOLD=90
# Duplicate detection (similarity 0-1): hard duplicate, soft variety warning, on-demand API check
DUPLICATE_HARD_THRESHOLD=0.75
DUPLICATE_SOFT_THRESHOLD=0.60
DUPLICATE_API_THRESHOLD=0.80
BATCH_PASSING_SCORE_THRESHOLD=85
DEFAULT_MAX_TOKENS=3000
REVIEWER_MAX_TOKENS=1800
# Upper bound when a truncated completion is retried with a larger token budget
LLM_MAX_TOKENS_CEILING=8000

# ------------------------------------------------------------------------------
# 6. Strict Temperature Settings (High Instruction Fidelity & Determinism)
# ------------------------------------------------------------------------------
DEFAULT_TEMPERATURE=0.2
# Drafting temperature (variety across a batch); passages use PASSAGE_TEMPERATURE
GENERATOR_TEMPERATURE=0.5
PASSAGE_TEMPERATURE=0.7
REGENERATOR_TEMPERATURE=0.2
REVIEWER_TEMPERATURE=0.1
BLIND_SOLVER_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# 7. Blind-Solver Dual Validation Agent
# ------------------------------------------------------------------------------
ENABLE_BLIND_SOLVER=true
# Optional dedicated model for the independent solver (empty = same model as the request)
BLIND_SOLVER_MODEL=
# Solver samples on different option layouts: 1 = single, 2 = two concurrent, 3 = tie-breaker on split
BLIND_SOLVER_SAMPLES=2
# Always run the independent reviewer, even when the generator's self-critique passes
ALWAYS_INDEPENDENT_REVIEW=true
# Demos/tests without LLM keys: set true to use built-in mock fixtures. Leave false in production
# so a missing key fails loudly instead of producing fake questions.
OFFLINE_MODE=false
# Run reviewer and blind solver concurrently (faster); set false to run them in sequence
PARALLEL_REVIEW_AND_SOLVE=true
# Mark static system prompts cacheable (Anthropic prompt caching)
ENABLE_PROMPT_CACHING=true
# Optional secret for the full /api/health payload (send as x-admin-key)
ADMIN_API_KEY=
# Optional shared secret: when set, POST/PUT/PATCH/DELETE calls need an X-API-Key header
# (the frontend sends VITE_API_ACCESS_KEY if you build it with that variable)
API_ACCESS_KEY=
# Log output: text or json (structured, one object per line)
LOG_FORMAT=text
BLIND_SOLVER_CONFIDENCE_THRESHOLD=88
BLIND_SOLVER_MAX_TOKENS=1200

# ------------------------------------------------------------------------------
# 8. Global Multi-Batch Concurrency, Queues & Rate Limiting Controls
# ------------------------------------------------------------------------------
# Question pipelines in flight across ALL runs and batches
GLOBAL_MAX_CONCURRENT_PIPELINES=8
GLOBAL_MAX_CONCURRENT_JOBS=4
GLOBAL_MAX_CONCURRENT_LLM_CALLS=10
LLM_MAX_RETRIES=4
LLM_BASE_BACKOFF_SECONDS=1.5
WORKFLOW_MAX_WORKER_RETRIES=2

# ------------------------------------------------------------------------------
# 9. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://mcat_user:mcat_password@localhost:5432/mcat_db

# ------------------------------------------------------------------------------
# 10. Database Connection Pool Settings
# ------------------------------------------------------------------------------
# Keep workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) below Postgres max_connections (default 100) minus ~10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 11. CORS Trusted Origins (comma-separated or JSON list)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend dev server (read by frontend/vite.config.js)
# ------------------------------------------------------------------------------
# Extra hostnames the Vite dev server accepts, comma-separated (e.g. a tunnel hostname)
VITE_ALLOWED_HOSTS=
# Optional shared secret sent as X-API-Key; must match API_ACCESS_KEY on the backend
VITE_API_ACCESS_KEY=
