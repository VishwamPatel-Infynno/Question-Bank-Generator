{
  "name": "infynno-mcat-question-bank-generator-root",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "predev": "pnpm run clean:ports",
    "dev": "concurrently --kill-others-on-fail -n backend,frontend -c magenta.bold,cyan.bold \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "clean:ports": "node scripts/clean-ports.mjs",
    "dev:backend": "uv run uvicorn app.main:app --app-dir backend --port 8000 --reload",
    "dev:frontend": "pnpm --silent --dir frontend exec vite",
    "build": "pnpm --dir frontend run build",
    "lint": "pnpm --dir frontend run lint",
    "lint:backend": "uv run ruff check .",
    "format": "uv run ruff format .",
    "format:check": "uv run ruff format --check .",
    "test": "pnpm run test:backend",
    "test:backend": "uv run pytest",
    "db:clean-duplicates": "uv run python scripts/clean_duplicate_artifacts.py",
    "preview": "pnpm --dir frontend run preview",
    "test:frontend": "pnpm --dir frontend run test",
    "sync:taxonomy": "node -e \"const fs = require('node:fs'); fs.copyFileSync('backend/app/data/mcat_dependent_taxonomy.json', 'frontend/src/constants/mcat_dependent_taxonomy.json');\"",
    "db:seed": "uv run python backend/scripts/seed_questions.py",
    "lint:all": "pnpm run lint:backend && pnpm run lint",
    "test:all": "pnpm run test:backend && pnpm run test:frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
