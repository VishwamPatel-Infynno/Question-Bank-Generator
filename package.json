{
  "name": "infynno-mcat-question-bank-generator-root",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "predev": "pnpm run clean:ports",
    "dev": "concurrently --kill-others-on-fail -p '[{name}]' -n 'backend,frontend' -c 'magenta.bold,cyan.bold' 'pnpm --silent run dev:backend' 'pnpm --silent run dev:frontend'",
    "clean:ports": "lsof -ti :8000 -ti :5173 | xargs kill 2>/dev/null || true",
    "dev:backend": "PYTHONPATH=backend ./.venv/bin/uvicorn app.main:app --port 8000 --reload --reload-dir backend/app",
    "dev:frontend": "pnpm --silent --dir frontend exec vite",
    "build": "pnpm --dir frontend run build",
    "lint": "pnpm --dir frontend run lint",
    "lint:backend": "ruff check .",
    "format": "ruff format .",
    "format:check": "ruff format --check .",
    "test": "pnpm run test:backend",
    "test:backend": "pytest",
    "db:clean-duplicates": "PYTHONPATH=backend ./.venv/bin/python scripts/clean_duplicate_artifacts.py",
    "preview": "pnpm --dir frontend run preview",
    "test:frontend": "pnpm --dir frontend run test",
    "sync:taxonomy": "cp backend/app/data/mcat_dependent_taxonomy.json frontend/src/constants/mcat_dependent_taxonomy.json",
    "db:seed": "PYTHONPATH=backend ./.venv/bin/python backend/scripts/seed_questions.py",
    "lint:all": "pnpm run lint:backend && pnpm run lint",
    "test:all": "pnpm run test:backend && pnpm run test:frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
